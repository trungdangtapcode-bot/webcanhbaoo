CAMERA_ID=CAM_001
RTSP_URL=rtsp://admin:admin123@192.168.1.100:554/stream1
BACKEND_URL=http://localhost:3000/api/events
API_TOKEN=<jwt-token-from-backend>
DETECTOR_HOST=127.0.0.1
DETECTOR_PORT=5055
DETECTOR_ENABLE_YOLO=true
DETECTOR_YOLO_WEIGHTS=yolov8n.pt
DETECTOR_YOLO_FALLBACK_WEIGHTS=yolov8m.pt
DETECTOR_YOLO_CONF=0.25
DETECTOR_YOLO_SLICE_CONF=0.20
DETECTOR_YOLO_IOU=0.45
DETECTOR_YOLO_IMG_SIZE=640
DETECTOR_YOLO_ENABLE_SLICES=false
DETECTOR_GROQ_ENABLED=false
GROQ_API_KEY=your-groq-api-key
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
HANOI_PROXY_HOST=127.0.0.1
HANOI_PROXY_PORT=5001
HANOI_PROXY_FPS=10
HANOI_PROXY_JPEG_QUALITY=4
HANOI_PROXY_IDLE_SECONDS=75
HANOI_PROXY_STALE_SECONDS=20
HANOI_PROXY_SNAPSHOT_TIMEOUT=12
HANOI_WSS_HEADER_BYTES=12
DETECTOR_FIRE_RATIO=0.035
DETECTOR_FLOOD_WATCH_RATIO=0.22
DETECTOR_FLOOD_ALERT_RATIO=0.38
DETECTOR_FLOOD_MIN_AREA=2500
DETECTOR_FLOOD_ROI_START_RATIO=0.45
DETECTOR_FLOOD_MIN_LARGEST_BLOB_RATIO=0.08
DETECTOR_FLOOD_MIN_BOTTOM_COVERAGE=0.18
DETECTOR_FLOOD_MAX_TEXTURE_SCORE=0.50
DETECTOR_FLOOD_MAX_EDGE_DENSITY=0.18
DETECTOR_TRAFFIC_MIN_VEHICLES=8

# ── Traffic Temporal Analysis (NEW) ──────────────────────────────────────────
# Displacement threshold (pixels): below this = vehicle is STOPPED
DETECTOR_TRAFFIC_SPEED_STOPPED=5.0
# Displacement threshold (pixels): below this = vehicle is SLOW
DETECTOR_TRAFFIC_SPEED_SLOW=15.0
# Number of consecutive congested frames required to confirm traffic jam
DETECTOR_TRAFFIC_JAM_CONFIRM=3
# Number of consecutive flowing frames required to clear a traffic jam
DETECTOR_TRAFFIC_JAM_CLEAR=2
# IoU threshold for matching vehicles between consecutive frames
DETECTOR_TRAFFIC_IOU_THRESHOLD=0.3
