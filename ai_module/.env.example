CAMERA_ID=CAM_001
RTSP_URL=rtsp://admin:admin123@192.168.1.100:554/stream1
BACKEND_URL=http://localhost:3000/api/events
API_TOKEN=<jwt-token-from-backend>

# USB camera settings
USB_CAMERA_INDEX=0
# Windows: dshow is usually more stable than msmf for USB webcams.
# Options: auto, dshow, msmf, any
USB_CAMERA_BACKEND=auto
CAM_WIDTH=1280
CAM_HEIGHT=720
TARGET_FPS=30
SHOW_PREVIEW=true
