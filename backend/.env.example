PORT=3000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/smart_alert
REDIS_URL=redis://localhost:6379

# Legacy device token secret (for AI module camera auth)
API_SECRET=your-very-long-random-secret-minimum-32-chars

# User JWT Authentication
JWT_SECRET=your-very-long-jwt-secret-minimum-32-chars-change-this
JWT_EXPIRES_IN=24h

# Chatbot AI (Groq API) — get free key at console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
