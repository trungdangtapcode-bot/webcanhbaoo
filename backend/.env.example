PORT=3000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/smart_alert
REDIS_URL=redis://localhost:6379
API_SECRET=your-very-long-random-secret-minimum-32-chars
NEWS_CACHE_TTL_MS=600000
NEWS_REQUEST_TIMEOUT_MS=8000
HCM_TRAFFIC_BASE_URL=https://giaothong.hochiminhcity.gov.vn
HCM_CAMERA_RENDER_BASE_URL=https://giaothong.hochiminhcity.gov.vn:8007
HCM_CAMERA_SESSION_TTL_MS=900000
HCM_CAMERA_SNAPSHOT_TIMEOUT_MS=12000
SCANNER_AUTOSTART=false
SCANNER_CAMERA_SOURCE=hcm
SCANNER_CAMERA_LIMIT=12
SCANNER_CONCURRENCY=4
SCANNER_INTERVAL_MS=10000
SCANNER_MIN_CONFIDENCE=0.6
SCANNER_MOCK_DETECTIONS=false
